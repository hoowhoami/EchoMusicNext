#version 440
layout(local_size_x=4) in;
layout(std140,binding=1) uniform Color {vec4 multiplier;} params;
layout(std430,binding=3) buffer Values {float values[];} outputValues;
layout(rgba16f,binding=4) uniform writeonly image2D outputImage;
void main(){uint i=gl_GlobalInvocationID.x;if(i<16)outputValues.values[i]=float(i)*3.0+params.multiplier.x;if(i<4)imageStore(outputImage,ivec2(i%2,i/2),vec4(4.0,2.0,0.5,1.0));}
