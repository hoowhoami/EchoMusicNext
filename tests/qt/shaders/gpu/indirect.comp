#version 440
layout(local_size_x = 1) in;
layout(std430, binding = 3) buffer Arguments { uint words[]; } args;
void main()
{
    for (int i = 0; i < 40; ++i) args.words[i] = 0;
    args.words[4] = 4; args.words[5] = 1;
    args.words[12] = 4; // second non-indexed command has zero instances
    args.words[20] = 6; args.words[21] = 1;
    args.words[28] = 6; // second indexed command also has zero instances
}
