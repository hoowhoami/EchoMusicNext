# Keep formatter output identical in Windows/macOS/Linux checkouts.
* text=auto eol=lf
# Unified diff context lines may contain a single space.
cmake/patches/*.patch whitespace=-blank-at-eol
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
# Preferred upstream sources and license notices are verified byte for byte.
tools/audio-analysis-helper/upstream/** -text
tools/audio-analysis-helper/third_party/** -text
