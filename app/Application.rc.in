#define IDI_ICON1 1
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/icon.ico"
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "hoowhoami\0"
   VALUE "FileDescription", "EchoMusicNext\0"
   VALUE "FileVersion", "@ECHO_RELEASE_VERSION@\0"
   VALUE "ProductVersion", "@ECHO_RELEASE_VERSION@\0"
   VALUE "ProductName", "EchoMusicNext\0"
   VALUE "OriginalFilename", "EchoMusicNext.exe\0"
   VALUE "Comments", "Build @ECHO_BUILD_ID@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
