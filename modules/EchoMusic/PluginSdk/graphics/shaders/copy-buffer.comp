#version 440
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Source { uint values[]; } sourceBuffer;
layout(std430, binding = 1) writeonly buffer Destination { uint values[]; } destinationBuffer;
layout(std140, binding = 2) uniform Copy { uvec4 ranges; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * params.ranges.w;
    if (i < params.ranges.z)
        destinationBuffer.values[params.ranges.y + i] = sourceBuffer.values[params.ranges.x + i];
}
